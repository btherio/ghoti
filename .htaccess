# Apache hardening for ghoti (applies when AllowOverride is enabled).
# If the site runs on nginx, replicate these rules in the server config
# (deny the FilesMatch names below; hide dot-directories; -Indexes).

# No directory listings.
Options -Indexes

# Hide dot-directories (git metadata, agent dirs, ...) from HTTP.
# Match at any installation depth; permit ACME's .well-known directory.
RedirectMatch 404 "(?:^|/)\.(?!well-known(?:/|$))[^/]+(?:/|$)"

# Block direct HTTP access to files that contain secrets or runtime data.
# They are still perfectly usable via PHP include/require - this only stops
# someone downloading them through the web server.
<FilesMatch "^(ghoti\.log|ghoti\.log\.[0-9]+|ghoti\.settings\.json|db\.config\.php|db\.config\.local\.php|db\.provisioned\.json|critical-alerts\.json|critical-alerts\.pending\.json|critical-alerts\.history\.json|login\.throttle\.json(\.tmp)?|security\.blacklist\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Search engines look for these at the site root; seo.php builds them from
# Site Settings -> SEO and the public page list. Without mod_rewrite they are
# still reachable at seo.php?file=robots and seo.php?file=sitemap.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^robots\.txt$ seo.php?file=robots [L]
    RewriteRule ^sitemap\.xml$ seo.php?file=sitemap [L]
</IfModule>
