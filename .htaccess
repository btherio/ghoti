# Apache hardening for ghoti (applies when AllowOverride is enabled).
# If the site runs on nginx, replicate these rules in the server config
# (deny the FilesMatch names below; hide dot-directories; -Indexes).

# No directory listings.
Options -Indexes

# Hide dot-directories (git metadata, agent dirs, ...) from HTTP.
RedirectMatch 404 "^/\.git($|/)"
RedirectMatch 404 "^/\.reasonix($|/)"
RedirectMatch 404 "^/\.claude($|/)"

# Block direct HTTP access to files that contain secrets or runtime data.
# They are still perfectly usable via PHP include/require - this only stops
# someone downloading them through the web server.
<FilesMatch "^(ghoti\.log|ghoti\.log\.[0-9]+|ghoti\.settings\.json|db\.config\.php|db\.config\.local\.php|db\.provisioned\.json|login\.throttle\.json(\.tmp)?)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
