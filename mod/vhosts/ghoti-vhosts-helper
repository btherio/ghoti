#!/bin/bash
#
# ghoti-vhosts-helper - the only privileged thing the ghoti vhosts module runs.
#
# Install (as root, on the Apache server):
#
#   install -o root -g root -m 0755 ghoti-vhosts-helper /usr/local/sbin/ghoti-vhosts-helper
#   install -o root -g root -m 0440 sudoers.ghoti-vhosts /etc/sudoers.d/ghoti-vhosts
#   visudo -c                      # confirm the sudoers file parses
#
# Design notes
# ------------
# PHP runs as the unprivileged `http` user and calls this through a single
# sudoers rule (NOPASSWD, this path only). Everything that needs root - writing
# /etc/httpd/conf/conf.d, reloading httpd, reading /etc/letsencrypt/live - is
# reachable ONLY through the fixed verbs below. There is deliberately no verb
# that takes a command, a format string, or an arbitrary path: the caller names
# a vhost, and this script derives every path from it. New vhost config arrives
# on stdin, never as an argument, so nothing the admin types is ever word-split
# by a shell.
#
# Exit codes: 0 success, 1 usage/validation error, 2 operation failed.

set -o errexit -o nounset -o pipefail

VERSION="1.0.0"
DROPIN_DIR="/etc/httpd/conf/conf.d"
BACKUP_DIR="/var/lib/ghoti-vhosts/backups"
APACHECTL="/usr/bin/apachectl"
CERTBOT="/usr/bin/certbot"
SYSTEMCTL="/usr/bin/systemctl"
HTTPD_SERVICE="httpd"
MAX_CONF_BYTES=65536
MAX_IMPORT_BYTES=2097152

die() { printf '%s\n' "$1" >&2; exit "${2:-2}"; }

# A drop-in file stem. Must match VhostsParser::isSafeName() on the PHP side;
# re-checked here because a root helper never trusts its caller's validation.
require_name() {
	local name="${1:-}"
	[[ -n "$name" ]] || die "missing vhost name" 1
	[[ ${#name} -le 64 ]] || die "vhost name too long" 1
	[[ "$name" =~ ^[a-z0-9]([a-z0-9._-]{0,62}[a-z0-9])?$ ]] || die "invalid vhost name: $name" 1
	[[ "$name" != *".."* ]] || die "invalid vhost name: $name" 1
}

conf_path() { printf '%s/%s.conf' "$DROPIN_DIR" "$1"; }

# Roll the drop-in file back to $1 (a backup path, or empty to remove it), then
# report why. Used whenever configtest rejects a write - a broken conf.d file
# would take the whole server down on the next restart, so it never survives.
rollback() {
	local backup="${1:-}" target="$2" reason="$3"
	if [[ -n "$backup" && -f "$backup" ]]; then
		cp -p -- "$backup" "$target"
	else
		rm -f -- "$target"
	fi
	"$APACHECTL" configtest >/dev/null 2>&1 || true
	printf 'configtest failed, change rolled back:\n%s\n' "$reason" >&2
	exit 2
}

cmd_ping() {
	printf 'ghoti-vhosts-helper %s\n' "$VERSION"
	printf 'dropInDir=%s\n' "$DROPIN_DIR"
	printf 'certbot=%s\n' "$([[ -x "$CERTBOT" ]] && printf yes || printf no)"
}

cmd_configtest() { "$APACHECTL" configtest 2>&1; }

cmd_reload() {
	"$APACHECTL" configtest >/dev/null 2>&1 || die "refusing to reload: apachectl configtest fails"
	"$SYSTEMCTL" reload "$HTTPD_SERVICE" 2>&1
	printf 'reloaded %s\n' "$HTTPD_SERVICE"
}

# `apachectl -S`: which vhost actually serves which name/port, as Apache sees
# it after parsing every include. The ground truth the UI compares against.
cmd_vhost_map() { "$APACHECTL" -S 2>&1; }

cmd_list_certs() {
	[[ -x "$CERTBOT" ]] || die "certbot is not installed"
	"$CERTBOT" certificates 2>&1
}

# write <name>  - new config arrives on stdin, is staged, configtested, and
# either kept (with the previous version backed up) or rolled back.
cmd_write() {
	require_name "${1:-}"
	local name="$1" target backup="" staged
	target="$(conf_path "$name")"

	mkdir -p -- "$DROPIN_DIR" "$BACKUP_DIR"
	chmod 0750 "$BACKUP_DIR"

	staged="$(mktemp "${DROPIN_DIR}/.ghoti-${name}.XXXXXX")"
	trap 'rm -f -- "$staged"' EXIT
	head -c "$MAX_CONF_BYTES" > "$staged"
	[[ -s "$staged" ]] || die "refusing to write an empty config" 1

	if [[ -f "$target" ]]; then
		#mktemp, not a bare timestamp: two saves in the same second would
		#otherwise overwrite each other's backup.
		backup="$(mktemp "${BACKUP_DIR}/${name}.conf.$(date +%Y%m%d-%H%M%S).XXXX")"
		cp -p -- "$target" "$backup"
	fi

	install -o root -g root -m 0644 -- "$staged" "$target"
	rm -f -- "$staged"
	trap - EXIT

	local output
	if ! output="$("$APACHECTL" configtest 2>&1)"; then
		rollback "$backup" "$target" "$output"
	fi
	printf 'wrote %s\n' "$target"
	[[ -n "$backup" ]] && printf 'previous version saved to %s\n' "$backup"
	return 0
}

# delete <name> - same safety contract as write: if removing the file somehow
# breaks the config, put it back.
cmd_delete() {
	require_name "${1:-}"
	local name="$1" target backup output
	target="$(conf_path "$name")"
	[[ -f "$target" ]] || die "no such vhost file: $target" 1

	mkdir -p -- "$BACKUP_DIR"
	chmod 0750 "$BACKUP_DIR"
	backup="$(mktemp "${BACKUP_DIR}/${name}.conf.$(date +%Y%m%d-%H%M%S).XXXX")"
	cp -p -- "$target" "$backup"
	rm -f -- "$target"

	if ! output="$("$APACHECTL" configtest 2>&1)"; then
		rollback "$backup" "$target" "$output"
	fi
	printf 'removed %s\n' "$target"
	printf 'a copy was saved to %s\n' "$backup"
}

# issue <name> <email> - obtain a Let's Encrypt certificate for the names in a
# managed vhost. The domains and webroot are read out of the vhost file HERE
# rather than passed in, so the caller cannot aim certbot at arbitrary paths.
cmd_issue() {
	require_name "${1:-}"
	local name="$1" email="${2:-}" conf docroot
	conf="$(conf_path "$name")"
	[[ -f "$conf" ]] || die "no such vhost file: $conf" 1
	[[ -x "$CERTBOT" ]] || die "certbot is not installed"
	[[ "$email" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || die "invalid contact email" 1

	docroot="$(awk 'tolower($1)=="documentroot"{gsub(/"/,"",$2); print $2; exit}' "$conf")"
	[[ -n "$docroot" && -d "$docroot" ]] || die "vhost has no usable DocumentRoot" 1

	local -a domains=()
	local host
	while read -r host; do
		[[ -n "$host" ]] && domains+=(-d "$host")
	done < <(awk 'tolower($1)=="servername"||tolower($1)=="serveralias"{for(i=2;i<=NF;i++){gsub(/"/,"",$i); print $i}}' "$conf" | sort -u)
	[[ ${#domains[@]} -gt 0 ]] || die "vhost declares no ServerName/ServerAlias" 1

	"$CERTBOT" certonly --webroot -w "$docroot" "${domains[@]}" \
		--cert-name "$name" --non-interactive --agree-tos -m "$email" 2>&1
}

# import <sourceFile> - adopt hand-written vhosts into the drop-in directory.
#
# The migration plan arrives on stdin as frames:
#   ===GHOTI-IMPORT-FILE <name>.conf
#   <file content>
#   ===GHOTI-IMPORT-END
#
# All files are staged, then moved in together, then the source file is replaced
# by a stub, then configtest runs ONCE over the result. Any failure restores
# every file and the source. There is no window in which half the vhosts have
# moved, and never a moment with the same vhost defined twice.
cmd_import() {
	local source="${1:-}"
	[[ -n "$source" ]] || die "missing source file" 1
	# An absolute path with no traversal. This is the only path argument any
	# verb accepts, so it is checked tightly rather than trusted.
	[[ "$source" = /* ]] || die "source must be an absolute path" 1
	[[ "$source" != *".."* ]] || die "invalid source path" 1
	[[ -f "$source" ]] || die "no such file: $source" 1
	[[ -r "$source" && -w "$source" ]] || die "cannot read and write $source" 1

	mkdir -p -- "$DROPIN_DIR" "$BACKUP_DIR"
	chmod 0750 "$BACKUP_DIR"

	# Deliberately NOT `local`: the EXIT trap below runs after this function's
	# frame is gone, and under `set -u` a local would be unset by then and turn
	# a successful import into a spurious failure.
	local stamp
	stamp="$(date +%Y%m%d-%H%M%S)"
	IMPORT_STAGE="$(mktemp -d "${BACKUP_DIR}/.import-${stamp}.XXXX")"
	IMPORT_RESTORE="$(mktemp -d "${BACKUP_DIR}/.restore-${stamp}.XXXX")"
	trap 'rm -rf -- "${IMPORT_STAGE:-}" "${IMPORT_RESTORE:-}"' EXIT
	local stage="$IMPORT_STAGE" restore="$IMPORT_RESTORE"

	# Split the plan into staged files. Only the frame headers are interpreted;
	# file content is written through untouched.
	head -c "$MAX_IMPORT_BYTES" | awk -v dir="$stage" '
		/^===GHOTI-IMPORT-FILE /{ f = dir "/" $2; next }
		/^===GHOTI-IMPORT-END$/ { f = ""; next }
		f { print > f }
	'

	local staged=()
	local path base
	for path in "$stage"/*; do
		[[ -e "$path" ]] || continue
		base="$(basename -- "$path")"
		# Re-validate every filename the plan asked for: same rule as write(),
		# applied to the stem. A root helper never trusts its caller.
		[[ "$base" == *.conf ]] || die "plan contains a non-.conf file: $base" 1
		require_name "${base%.conf}"
		[[ -s "$path" ]] || die "plan contains an empty file: $base" 1
		staged+=("$base")
	done
	[[ ${#staged[@]} -gt 0 ]] || die "the import plan is empty" 1

	# Refuse to clobber anything already in place - an import is a one-time
	# migration, not an overwrite.
	for base in "${staged[@]}"; do
		[[ -e "${DROPIN_DIR}/${base}" ]] && die "${DROPIN_DIR}/${base} already exists; nothing was changed" 1
	done

	cp -p -- "$source" "${restore}/source.orig"

	local applied=()
	local failed=""
	for base in "${staged[@]}"; do
		if ! install -o root -g root -m 0644 -- "${stage}/${base}" "${DROPIN_DIR}/${base}"; then
			failed="could not write ${DROPIN_DIR}/${base}"
			break
		fi
		applied+=("$base")
	done

	local sourceBackup="${BACKUP_DIR}/$(basename -- "$source").${stamp}"
	if [[ -z "$failed" ]]; then
		cp -p -- "${restore}/source.orig" "$sourceBackup"
		# Neutralise the source in the same pass: leaving it in place would mean
		# every vhost defined twice, with the old copy still winning.
		write_import_stub "$source" "$sourceBackup"

		local output
		if ! output="$("$APACHECTL" configtest 2>&1)"; then
			failed="$output"
		fi
	fi

	if [[ -n "$failed" ]]; then
		for base in "${applied[@]}"; do rm -f -- "${DROPIN_DIR}/${base}"; done
		cp -p -- "${restore}/source.orig" "$source"
		rm -f -- "$sourceBackup"
		rm -rf -- "$restore"
		"$APACHECTL" configtest >/dev/null 2>&1 || true
		printf 'import failed, everything rolled back:\n%s\n' "$failed" >&2
		exit 2
	fi

	rm -rf -- "$stage" "$restore"
	IMPORT_STAGE=""; IMPORT_RESTORE=""
	trap - EXIT
	printf 'imported %d file(s) into %s\n' "${#applied[@]}" "$DROPIN_DIR"
	printf 'original saved to %s\n' "$sourceBackup"
	for base in "${applied[@]}"; do printf '  %s\n' "$base"; done
	return 0
}

# Replace the migrated source file with a note explaining where its vhosts went.
write_import_stub() {
	local target="$1" backup="$2"
	{
		printf '#############################################################################\n'
		printf '#  Vhosts moved to %s by the ghoti vhosts module\n' "$DROPIN_DIR"
		printf '#  on %s.\n' "$(date +%Y-%m-%d)"
		printf '#\n'
		printf '#  The original file was saved as:\n'
		printf '#      %s\n' "$backup"
		printf '#\n'
		printf '#  Each vhost now lives in its own file there, numerically prefixed to\n'
		printf '#  preserve the original order - which decides the default vhost per port.\n'
		printf '#  Add new vhosts through the admin panel, or as new files in that\n'
		printf '#  directory; do not put them back here.\n'
		printf '#############################################################################\n'
	} > "$target"
}

# renew <name> - force a renewal of one certificate by its certbot cert-name.
cmd_renew() {
	require_name "${1:-}"
	[[ -x "$CERTBOT" ]] || die "certbot is not installed"
	"$CERTBOT" renew --cert-name "$1" --force-renewal --non-interactive 2>&1
}

verb="${1:-}"
shift || true
case "$verb" in
	ping)        cmd_ping ;;
	configtest)  cmd_configtest ;;
	reload)      cmd_reload ;;
	vhost-map)   cmd_vhost_map ;;
	list-certs)  cmd_list_certs ;;
	write)       cmd_write "${1:-}" ;;
	import)      cmd_import "${1:-}" ;;
	delete)      cmd_delete "${1:-}" ;;
	issue)       cmd_issue "${1:-}" "${2:-}" ;;
	renew)       cmd_renew "${1:-}" ;;
	*)           die "usage: ghoti-vhosts-helper {ping|configtest|reload|vhost-map|list-certs|write <name>|import <sourceFile>|delete <name>|issue <name> <email>|renew <name>}" 1 ;;
esac
