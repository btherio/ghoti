# Untracked local override for database credentials (see db.config.php)
db.config.local.php

# Runtime cache of which module tables have been provisioned (see ghoti.db.php).
# Safe to delete; it will be rebuilt (and forces a re-check if you drop tables).
db.provisioned.json

# Per-install site settings edited via Admin Menu -> Site Settings (ghoti.php).
# Untracked so each installation keeps its own; delete to fall back to defaults.
ghoti.settings.json

# Runtime log + rotated generations (ghoti.php). Contains usernames/IPs - keep
# out of git and out of the web root.
ghoti.log
ghoti.log.*

# Server-side login throttling state (mod/login/login.async.php).
login.throttle.json

# Automatic IP blocks are runtime security state managed from Site Settings.
security.blacklist.json

# Local AI coding-agent instructions and per-tool state.
agents.md
AGENTS.md
CLAUDE.md
.reasonix/
reasonix.toml

# Throttled operational alert counters; never commit runtime state.
critical-alerts.json
